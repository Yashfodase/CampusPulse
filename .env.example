# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Application Port
PORT=3000

# JWT Authentication Secret Key
JWT_SECRET="college_event_mgmt_super_secret_jwt_key_2026"

# Relational Database Configuration (MySQL)
DATABASE_HOST="localhost"
DATABASE_PORT=3306
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="college_event_db"

# Set to "true" for cloud MySQL (Aiven, TiDB, etc.) that requires TLS
DATABASE_SSL="false"

# Only if frontend is on a different domain (e.g. Vercel): backend allows this origin
# CORS_ORIGIN="https://your-app.vercel.app"
# Frontend build variable (set on Vercel): URL of the backend, no trailing slash
# VITE_API_URL="https://your-backend.onrender.com"
